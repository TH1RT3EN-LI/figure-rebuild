# Normalize text files on checkout and keep scripts portable across platforms.
* text=auto
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# These formats contain binary data; never apply text conversion or line diffs.
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff binary
*.woff2 binary
*.zip binary
